  "about": {
    "heading": {
      "eyebrow": "About the Sangh",
      "title": "संघ परिचय"
    },
    "pageHeading": {
      "eyebrow": "Preamble",
      "title": "प्रस्तावना"
    },
    "intro": "उत्तर प्रदेशीय मिनिस्ट्रीयल कलेक्ट्रेट कर्मचारी संघ की मान्यता प्राप्त होने के साथ ही ऐसे दस्तावेज की आवश्यकता प्रतीत हुई, जिसमें निम्न बिन्दुओं का समावेश हो —",
    "points": [
      "साथ–साथ रहने वाले कलेक्ट्रेट मिनिस्ट्रीयल संवर्ग के सहयोगियों के मध्य जरूरी विश्वास तथा सहयोग विकसित हो।",
      "अच्छी एवं सशक्त कार्यकारिणी के गठन के लिये सदस्यों की आकांक्षाओं को व्यक्त करने का अधिकार।",
      "कार्यकारिणी का गठन कैसे होगा और निर्णय लेने का अधिकार किसके पास होगा।",
      "कार्यकारिणी के अधिकारों की सीमा तय करना और पदाधिकारियों / सदस्यों के कर्तव्य और उनके अधिकार।"
    ],
    "conclusion": "उपरोक्त बिन्दुओं को ध्यान में रखकर संघ के विद्वतगण के विचार संकलित कर लिपिबद्ध पुस्तक को तैयार किया गया, जिसे हम संघ का संविधान कहते हैं, जो संघ का सर्वोच्च कानून है।",
    "readMore": {
      "label": "विस्तार से पढ़ें",
      "href": "/about/"
    },
    "source": "स्रोत : संघ का संविधान (षष्ठम् संस्करण) — प्रस्तावना",
    "highlights": [
      {
        "clause": "धारा 2",
        "title": "मुख्यालय",
        "text": "प्रदेशीय संघ का मुख्यालय उस जनपद में रहेगा जिस जनपद का महामंत्री निर्वाचित होगा। प्रान्तीय संघ का कार्यालय भवन लखनऊ में होगा।"
      },
      {
        "clause": "धारा 3–4",
        "title": "जनपद शाखा",
        "text": "प्रत्येक जनपद में संघ की जनपद शाखा होगी, जो पूर्णतः प्रदेशीय संघ के नियंत्रण में होगी। जनपद शाखाओं का कार्यकाल दो वर्ष का होगा।"
      },
      {
        "clause": "धारा 8",
        "title": "सदस्यता",
        "text": "कलेक्ट्रेट संवर्ग में सेवारत कनिष्ठ सहायक से मुख्य प्रशासनिक अधिकारी तक संघ के सदस्य होंगे। जनपद शाखा में नियमित रूप से सदस्यता शुल्क जमा करने वाला प्रत्येक कर्मचारी संघ का सदस्य माना जायेगा।"
      },
      {
        "clause": "धारा 7",
        "title": "निषेध",
        "text": "प्रदेशीय संघ अथवा जनपद शाखा के सदस्य किसी भी राजनैतिक गतिविधियों में भाग नहीं ले सकेंगे।"
      }
    ],
