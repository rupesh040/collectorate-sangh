  "visionMission": {
    "heading": {
      "eyebrow": "Vision & Mission",
      "title": "दृष्टि एवं उद्देश्य"
    },
    "vision": {
      "eyebrow": "Vision",
      "title": "दृष्टि",
      "text": "कलेक्ट्रेट मिनिस्ट्रीयल संवर्ग के सहयोगियों के मध्य विश्वास तथा सहयोग विकसित हो, और किसी जाति या दलगत भेदभाव से दूर रहकर सभी सह कर्मचारियों में परिवार एवं भाईचारे का भाव बने।",
      "source": "स्रोत : संविधान — प्रस्तावना (क) एवं धारा 6(4)",
      "motto": "“संगठन ही शक्ति है, साथ ही प्रगति है”"
    },
    "mission": {
      "eyebrow": "Mission",
      "title": "उद्देश्य एवं कर्तव्य",
      "points": [
        "समुचित और संविधानिक उपायों द्वारा कर्मचारियों के हितों का संरक्षण एवं संवर्धन।",
        "कर्मचारियों के नैतिक, साहित्यिक, शारीरिक और सांस्कृतिक कार्यकलाप सम्बन्धी स्तरों का निरन्तर विकास।",
        "सहकारिता लाभों को प्राप्त करने का पूर्ण प्रयास।",
        "किसी जाति या दलगत भेदभाव से दूर रहकर सभी सह कर्मचारियों में परिवार एवं भाईचारे के भाव का विकास।",
        "यदि संघ के सदस्य के साथ कोई दुर्घटना हो जाती है, तो उसको अथवा उसके परिवार को यथासंभव सहायता प्रदान करना।",
        "सेवाओं की गरिमा को बनाये रखने हेतु हर संभव प्रयास।"
      ],
      "source": "स्रोत : संघ का संविधान, धारा 6"
    }
  },
